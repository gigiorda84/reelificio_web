# Cal.com booking handle (e.g. "reelificio/discovery")
NEXT_PUBLIC_CAL_LINK=reelificio/discovery

# Plausible (omit DOMAIN to disable Plausible entirely)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=reelificio.com
NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js

# Resend (server-side only)
RESEND_API_KEY=
RESEND_FROM="Reelificio <noreply@reelificio.com>"
RESEND_TO=hello@reelificio.com

# Brevo — FUN-GÒ waitlist (server-side only)
# List ID: Brevo dashboard → Contacts → Lists → "Fun-Go" → the numeric id in the URL/settings
BREVO_API_KEY=
BREVO_FUNGO_LIST_ID=
